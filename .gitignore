# ---------------------------------------------------------------------------
# Credentials. The private key is equivalent to a bank password.
# It must never be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

secrets/*
!secrets/.gitkeep

*.pem
*.key
*.p8
tiger_openapi_config.properties
tiger_openapi_token.properties

# ---------------------------------------------------------------------------
# Runtime artefacts
# ---------------------------------------------------------------------------
logs/
*.log

# Per-symbol enable/disable and bracket overrides, set from the page. This
# machine's operating state, like .env -- not part of the project.
symbol_settings.json

