# ---------------------------------------------------------------------------
# Credentials. The private key is equivalent to a bank password.
# It must never be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

secrets/*
!secrets/.gitkeep

*.pem
*.key
*.p8
tiger_openapi_config.properties
tiger_openapi_token.properties

# ---------------------------------------------------------------------------
# Runtime artefacts
# ---------------------------------------------------------------------------
logs/
*.log

# What the page saved: this machine's operating state, like .env -- not part
# of the project. All of it lives in state/:
#   symbol_settings.json        per-symbol enable/disable and brackets
#   time_bracket_settings.json  the clock-following bracket schedule
#   armed_settings.json         the SAFE/ARMED switch
state/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
vnv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# API server stdout capture
api_server.out
