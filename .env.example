# Copy this file to .env and fill it in. .env is gitignored -- keep it that way.
#
# The paper trading account ID is 17 digits. A Prime account is 5-10 digits and
# a Global account starts with U. Put the PAPER account ID in BOTH TIGER_ACCOUNT
# and TIGER_PAPER_ACCOUNT: they must be character-for-character identical for
# the system to run in PAPER mode.

TIGER_ID=
TIGER_ACCOUNT=
TIGER_PAPER_ACCOUNT=
TIGER_PRIVATE_KEY_PATH=./secrets/tiger_private_key.pem
TIGER_ALLOW_LIVE=false
DRY_RUN=true

# Where bid/ask/volume/open interest come from.
#   manual = typed in by hand from the Tiger app (no entitlement needed)
#   tiger  = fetched from the API (needs usOptionQuote market data)
MARKET_DATA_SOURCE=manual

# --- HTTP API (Phase 8) -----------------------------------------------------
# The fourth lock. Every request must send this as the X-API-Key header, or it
# is refused with 401 before it reaches a route. Generate a long random value;
# an HTTP port that can place orders is a different risk from a CLI.
TIGER_API_KEY=

# Bind address. 127.0.0.1 means only this machine can reach it. Do not set
# 0.0.0.0 unless you have genuinely decided to expose an order-placing service
# to your network.
API_HOST=127.0.0.1
API_PORT=8000

# How long a preview token stays valid. Matches the quote staleness limit,
# because a preview built from a typed quote goes stale for the same reason
# the quote does.
PREVIEW_TOKEN_TTL_SECONDS=60

# --- Phase 10: the fast single-call trading path (POST /trade) --------------

# The valid option price increment. MEASURED, not assumed: 32,360 real traded
# prices across 6 symbols, all penny at every price level. The widely quoted
# "penny under $3, nickel at $3 and above" convention was tested and refuted.
# Read HANDOVER.md section 3d before changing this.
OPTION_TICK_SIZE=0.01

# Whole ticks added to a BUY limit so it fills rather than sitting. A limit
# fills at the best available price, so the buffer costs nothing unless the
# market has genuinely moved.
LIMIT_BUFFER_TICKS=1

# Refuse to auto-select an expiry sooner than this. An option a day from
# expiry loses value fast and gaps hard.
MIN_DAYS_TO_EXPIRY=3

# How long a client_order_id is remembered, so a retry replays instead of
# placing a second order.
IDEMPOTENCY_TTL_SECONDS=600

# --- Optional -------------------------------------------------------------
# Not part of the build spec's .env template, but Tiger's docs list `license`
# alongside tiger_id and account as a developer value, and the SDK exposes
# client_config.license. Leave it unset first; set it only if the connection
# check fails in a way that points here. Values seen in Tiger's docs: TBHK,
# TBSG. Read yours off the developer information page rather than guessing.
# A TBHK licence additionally needs tiger_openapi_token.properties on disk.
#
# TIGER_LICENSE=
