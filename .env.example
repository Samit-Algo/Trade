# Copy this file to .env and fill it in. .env is gitignored -- keep it that way.
#
# The paper trading account ID is 17 digits. A Prime account is 5-10 digits and
# a Global account starts with U. Put the PAPER account ID in BOTH TIGER_ACCOUNT
# and TIGER_PAPER_ACCOUNT: they must be character-for-character identical for
# the system to run in PAPER mode.

TIGER_ID=
TIGER_ACCOUNT=
TIGER_PAPER_ACCOUNT=
TIGER_PRIVATE_KEY_PATH=./secrets/tiger_private_key.pem
TIGER_ALLOW_LIVE=false
DRY_RUN=true

# Where bid/ask/volume/open interest come from.
#   manual = typed in by hand from the Tiger app (no entitlement needed)
#   tiger  = fetched from the API (needs usOptionQuote market data)
MARKET_DATA_SOURCE=manual

# --- HTTP API (Phase 8) -----------------------------------------------------
# The fourth lock. Every request must send this as the X-API-Key header, or it
# is refused with 401 before it reaches a route. Generate a long random value;
# an HTTP port that can place orders is a different risk from a CLI.
TIGER_API_KEY=

# Bind address. 127.0.0.1 means only this machine can reach it. Do not set
# 0.0.0.0 unless you have genuinely decided to expose an order-placing service
# to your network.
API_HOST=127.0.0.1
API_PORT=8000

# How long a preview token stays valid. Matches the quote staleness limit,
# because a preview built from a typed quote goes stale for the same reason
# the quote does.
PREVIEW_TOKEN_TTL_SECONDS=60
