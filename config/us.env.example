# =============================================================================
#  US MARKET (Tiger)  --  config/us.env
# =============================================================================
#  Copy this file to config/us.env and fill it in. It is gitignored -- keep it that
#  way: it holds an account number API key, and the switch that decides
#  whether orders are real.
#
#  Everything here is validated when the server STARTS. A bad value refuses to
#  boot rather than failing later, mid-order. After changing anything in this
#  file you must RESTART the server -- it is read once.
#
#  Sections:
#    1. Who you are          Tiger credentials
#    2. Whether orders are real   <- the two that matter most
#    3. How the trade is sized    quantity, bracket, expiry, strike
#    4. How prices are decided    tick grid, buffer, freshness
# =============================================================================


# -----------------------------------------------------------------------------
# 1. WHO YOU ARE
# -----------------------------------------------------------------------------
# The paper account ID is 17 digits. A Prime account is 5-10 digits; a Global
# account starts with U.
#
# TIGER_ACCOUNT and TIGER_PAPER_ACCOUNT must be CHARACTER-FOR-CHARACTER
# identical, or the system will not resolve to PAPER mode. That comparison is
# Lock 1, and it is the only thing separating a paper order from a real one --
# the Tiger SDK treats both accounts identically.

TIGER_ID=
TIGER_ACCOUNT=
TIGER_PAPER_ACCOUNT=

# The PKCS#8 private key, on its own in a .pem file. NOT the
# tiger_openapi_config.properties file -- that contains the key but the SDK
# needs it bare, and pointing here at the properties file fails much later
# with an opaque signing error.
TIGER_PRIVATE_KEY_PATH=./secrets/tiger_private_key.pem

# Tiger's developer "license" value. OPTIONAL -- leave it blank first and
# set it only if the connection check fails in a way that points here.
# Read it off the developer information page rather than guessing. Values seen in their docs: TBHK, TBSG.
# A TBHK licence additionally needs tiger_openapi_token.properties on disk.
TIGER_LICENSE=


# -----------------------------------------------------------------------------
# 2. WHETHER ORDERS ARE REAL          <-- READ THIS SECTION BEFORE TRADING
# -----------------------------------------------------------------------------
# Lock 2. Allows an account that is NOT the declared paper account. Leaving
# this false means a mistyped TIGER_ACCOUNT refuses to start instead of
# quietly trading somewhere unexpected.
TIGER_ALLOW_LIVE=false

# Lock 3, and the single switch that decides what POST /trade does:
#
#   true   every price is worked out and returned, NOTHING is sent.
#          order_id comes back null and order_status is NOT_SUBMITTED.
#          This is how you test.
#
#   false  the same work, and then the order goes to the broker.
#
# There is no per-request override. What this says is what happens.
# SHIPPED AS true ON PURPOSE: a fresh copy of this file must not be able to
# spend money before anyone has read it.
DRY_RUN=true


# -----------------------------------------------------------------------------
# 3. HOW THE TRADE IS SIZED
# -----------------------------------------------------------------------------
# POST /trade takes only four inputs -- client_order_id, symbol, current_price
# and option_type. Every other decision about the trade is made here.

# Contracts per trade. One contract is 100 shares.
# Commission is a near-flat ~$3 each way, so a single cheap contract can pay
# 10%+ of its own value in fees. Range 1-1000.
TRADE_QUANTITY=1

# The bracket, as percentages of the entry premium.
# BOTH ARE REQUIRED and neither has a default: every other setting here can
# fall back to something safe, a bracket cannot.
#   TAKE_PROFIT_PERCENT   above 0, up to 1000
#   STOP_LOSS_PERCENT     above 0, below 100 (100% is the option at zero)
TAKE_PROFIT_PERCENT=
STOP_LOSS_PERCENT=

# How far out of the money, in WHOLE strikes. 1 is the first whole strike past
# the stock price. In-the-money strikes are never chosen. Range 1-10.
TRADE_STRIKES_OUT=1

# The most cash a SINGLE order may require, in dollars. An order priced above
# this is refused with TRADE_TOO_EXPENSIVE and nothing is sent. This is the
# same figure the response reports as cash_required: premium x quantity x 100,
# so 800 refuses anything over an $8.00 premium at quantity 1.
MAX_TRADE_CASH=800

# OPTIONAL: scale the number of contracts to the option's premium, so a cheap
# option buys more and an expensive one buys fewer. false means every trade
# uses TRADE_QUANTITY above, exactly as before.
QUANTITY_TIERS_ENABLED=false

# The table, as "upper_bound:quantity" pairs, lowest first. The bound is
# EXCLUSIVE, so a premium of exactly 1.00 falls into the 1.60 band.
#
#     under 1.00   -> 5 contracts   (up to $500)
#     1.00 - 1.60  -> 4 contracts   (up to $640)
#     1.60 - 2.65  -> 3 contracts   (up to $795)
#     2.65 - 4.00  -> 2 contracts   (up to $800)
#     4.00 and up  -> QUANTITY_TIER_TOP below
#
# THESE BANDS ARE SIZED FOR MAX_TRADE_CASH=800. Each band's top premium times
# its quantity lands at or under the cap, so the table never proposes an order
# the cap would refuse. Change the cap and these must be redrawn to match --
# the server refuses to start if a band can exceed the cap.
QUANTITY_TIERS=1.00:5, 1.60:4, 2.65:3, 4.00:2

# Applied above the highest band.
QUANTITY_TIER_TOP=1

# One-click sell prices on the order-history page, as DOLLARS BELOW the live
# premium. A step of 0.01 against a 0.50 premium offers to sell at 0.49.
#
# The point is speed: these price BELOW the market on purpose, so the order
# fills at once rather than resting on the book. Deeper steps fill harder.
#
# Any number of steps is allowed -- the buttons follow this list. Set it to
# nothing to turn the buttons off. The result is snapped DOWN onto a valid
# tick, and a step that would price at or below zero is refused.
QUICK_SELL_STEPS=0.01, 0.02, 0.03, 0.05, 0.10

# ---------------------------------------------------------------------------
# WHICH SYMBOLS, AND THEIR BRACKETS
# ---------------------------------------------------------------------------

# The symbols offered for trading. The /ui dropdown and the TradingView
# userscript both read this list, so adding one here is the only place it
# needs adding. Order is preserved -- the dropdown lists them as written.
TRADE_SYMBOLS=TSLA, AAPL, QQQ, NVDA

# PER-SYMBOL BRACKETS, all optional.
#
# A symbol without its own line uses TAKE_PROFIT_PERCENT / STOP_LOSS_PERCENT
# above. The two are independent: a symbol may set its take-profit and leave
# its stop-loss on the default.
#
# The bounds are the SAME ones the defaults are held to -- take-profit at or
# under 1000, stop-loss under 100 -- so a per-symbol value cannot reach
# anything the default could not. A bad one stops the server at startup.
#
# Only <SYMBOL>_* for a symbol in TRADE_SYMBOLS is read. A line for a symbol
# not on that list is inert: it sits here doing nothing.
#
# TSLA_TAKE_PROFIT_PERCENT=12
# TSLA_STOP_LOSS_PERCENT=20
#
# AAPL_TAKE_PROFIT_PERCENT=6
# AAPL_STOP_LOSS_PERCENT=8
#
# QQQ_TAKE_PROFIT_PERCENT=4
# QQQ_STOP_LOSS_PERCENT=6
#
# NVDA_TAKE_PROFIT_PERCENT=8
# NVDA_STOP_LOSS_PERCENT=15


# TIME-BASED BRACKETS, all optional and OFF unless enabled below.
#
# The minutes after the open are the volatile ones. A 5% take-profit that is
# sensible at noon is hit by noise in the first five minutes, before the move
# it was waiting for has happened. So the bracket widens for the opening
# stretch and tightens afterwards.
#
# WHERE IT SITS. Below a symbol's own bracket and above the global default:
#
#   1. supplied on the request        this trade only
#   2. set for the symbol in the page
#   3. <SYMBOL>_TAKE_PROFIT_PERCENT   above
#   4. the active window              <- these settings
#   5. TAKE_PROFIT_PERCENT            the global default
#
# So a symbol you tuned keeps its bracket all session; the clock governs the
# symbols nobody has tuned, which is what the default used to do alone.
#
# DECIDED AT ENTRY. The window is read once, when the order is built, and the
# position keeps the bracket it was born with. Nothing revisits an order that
# is already resting with the broker.
#
# THE PAGE OVERRIDES THESE. Saving the schedule in /ui writes
# time_bracket_settings.json, which wins until it is cleared with Reset --
# .env needs a restart, so the more recently changed value is the one meant.
TIME_BRACKETS_ENABLED=false

# Only affects how times are DISPLAYED and how a fixed start is read; the
# underlying moment is the same everywhere. An IANA name, not an abbreviation
# like IST -- India, Israel and Ireland all claim that one.
TIME_BRACKETS_TIMEZONE=Asia/Kolkata

# MARKET_OPEN follows the US session open (09:30 New York). India and
# Singapore never move their clocks but the United States does, so a fixed
# 19:00 is the open today and half an hour adrift of it from November --
# MARKET_OPEN keeps up on its own. A 24-hour time such as 19:00 pins it.
TIME_BRACKETS_START=MARKET_OPEN

# minutes:take_profit:stop_loss, earliest first, the last using * for the
# rest of the session. Below: 20/20 for the first 45 minutes, then 5/10.
#
# The * window is REQUIRED -- without it the table says nothing about the
# rest of the session. Add tiers freely: 45:20:20, 90:10:15, *:5:10.
#
# Same bounds as everywhere else: take-profit at or under 1000, stop-loss
# under 100. A bad table stops the server at startup, even when disabled --
# switching the schedule on mid-session should not be when its typo surfaces.
TIME_BRACKETS_WINDOWS=45:20:20, *:5:10


# Pin every trade to one expiry, as YYYY-MM-DD.
# LEAVE BLANK to auto-pick the soonest expiry at least MIN_DAYS_TO_EXPIRY away
# -- which is usually what you want, because a pinned date silently goes stale
# the day it passes.
TRADE_EXPIRY_DATE=

# Refuse to auto-pick anything sooner than this many days out. An option a day
# from expiry loses value fast and gaps hard. Ignored when TRADE_EXPIRY_DATE
# is set.
MIN_DAYS_TO_EXPIRY=3

# How long the take-profit and stop-loss legs rest on the book.
#   DAY  they die at the close -- an overnight position is then UNPROTECTED
#   GTC  they survive overnight (confirmed working on legs)
LEG_TIME_IN_FORCE=DAY


# -----------------------------------------------------------------------------
# 4. HOW PRICES ARE DECIDED
# -----------------------------------------------------------------------------
# The option price is not sent by the caller. It is the last traded price,
# fetched from free one-minute bars.

# The valid price increment. MEASURED, not assumed: 32,360 real traded prices
# across 6 symbols, all penny at every level. The widely quoted "penny under
# $3, nickel at $3 and above" convention was tested and REFUTED.
# Read HANDOVER.md section 3d before changing this.
OPTION_TICK_SIZE=0.01

# Whole ticks added to the BUY limit so it fills rather than resting.
#
# This matters more than it looks. What gets fetched is a LAST TRADE, not an
# ask -- nobody is promising to sell at it. On a wide spread the real ask sits
# above it, and the order simply will not fill. A limit still fills at the best
# available price, so the buffer costs nothing unless the market has genuinely
# moved.
#
# At 1 tick with OPTION_TICK_SIZE=0.01 you bid a penny over the last trade.
# Raise it on a thin contract with a wide spread.
LIMIT_BUFFER_TICKS=1

# --- OPTIONAL: buffer scaled to the premium -------------------------------
# A flat buffer is the wrong shape: 5 cents is 3.1% of a $1.60 option and
# 0.8% of a $6.00 one. These tiers scale it instead:
#
#     premium        buffer
#     < 1.50          0.02   (specified as 0.01 -- see the floor below)
#     1.50 - 2.50     0.02
#     2.50 - 3.50     0.03
#     3.50 - 6.00     0.05
#     > 6.00          0.10
#
# Backtested against 55 real filled BUYs: the tiers as specified would have
# filled 52/55, and all three misses were short by EXACTLY ONE CENT in the
# cheapest band. A missed limit is no fill at all, not a worse fill, so the
# bottom band is lifted to 2 ticks by default -- that fills 55/55 at an
# average buffer of 0.044 instead of 0.050.
#
# TO TURN THIS OFF set false, and LIMIT_BUFFER_TICKS above applies to every
# trade again. Nothing else changes.
BUFFER_TIERS_ENABLED=true

# The smallest buffer any tier may produce, in ticks. Set 1 to run the tiers
# exactly as specified; 2 is the measured-safe value.
BUFFER_TIER_FLOOR_TICKS=2

# Refuse to trade unless the contract has traded during the CURRENT minute.
# A price carried forward from several minutes ago is not something to place
# an order against. Turn this on for fast trading; it will refuse more often
# on thin contracts.
REQUIRE_LIVE_TRADING=false

# How long a hand-typed bid stays usable, in seconds, when valuing positions.
# (Called PREVIEW_TOKEN_TTL_SECONDS before Phase 11 removed preview tokens.
# The old name still works if it is set.)
QUOTE_STALE_AFTER_SECONDS=60

# Where bid/ask/volume/open interest come from.
#   manual  typed in by hand from the Tiger app (no entitlement needed)
#   tiger   fetched from the API (needs the usOptionQuote entitlement)
MARKET_DATA_SOURCE=manual
