# =============================================================================
#  INDIA (NIFTY) -- settings
# =============================================================================
#  Copy this file to config/india.env and fill it in:
#
#      copy config\india.env.example config\india.env
#
#  config/india.env is gitignored. Its presence is what turns India on: the
#  page shows a US / India switch only while the file exists.
#
#  The TRADING keys below are the same ones .env uses for the US and mean the
#  same thing. Only the numbers differ -- rupees, lots, a five-paise tick.
#
#  Read once when the server starts. RESTART the server after changing it.
#  Anything the page can change (symbols on/off, their brackets, the time
#  schedule, the SAFE/ARMED switch) is changed there without a restart, and
#  is kept separately from the US.
#
#  Sections:
#    1. Reaching OpenAlgo
#    2. Whether orders are real      <- read this one
#    3. How the trade is sized
#    4. Which symbols, and their brackets
#    5. Time-based brackets
#    6. How prices are decided
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REACHING OPENALGO
# -----------------------------------------------------------------------------
# This service does not talk to Angel directly. OpenAlgo holds your Angel
# session and does the broker work; it must be running before India can trade.
#
# OPENALGO_API_KEY is OpenAlgo's OWN key, from its "API Key" page in the
# browser. It is NOT your Angel SmartAPI key. Paste it here, never in a chat.
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=

EXCHANGE=NFO

# NRML or MIS.
PRODUCT=NRML


# -----------------------------------------------------------------------------
# 2. WHETHER ORDERS ARE REAL          <-- READ THIS SECTION BEFORE TRADING
# -----------------------------------------------------------------------------
# Angel has NO paper account. OpenAlgo has one "Analyze" switch: ON means
# simulated, OFF means real orders on your real Angel account.
#
# While ALLOW_LIVE=false, every order checks that switch first and is REFUSED
# unless Analyze is ON. That check is the only thing between a bug and your
# money. Leave it false until you have watched India trade in Analyze mode.
ALLOW_LIVE=false

# true   every price is worked out and returned, NOTHING is sent.
# false  the same, and then the order goes to OpenAlgo.
# The page's SAFE/ARMED switch overrides this, for India only.
DRY_RUN=true


# -----------------------------------------------------------------------------
# 3. HOW THE TRADE IS SIZED
# -----------------------------------------------------------------------------
# LOTS per trade, not shares. The lot size comes from OpenAlgo's symbol list
# when the order is priced (NIFTY: 65 in September 2026).
TRADE_QUANTITY=1

# The bracket, as percentages of the entry premium. BOTH ARE REQUIRED.
#   TAKE_PROFIT_PERCENT   above 0, up to 1000
#   STOP_LOSS_PERCENT     above 0, below 100
TAKE_PROFIT_PERCENT=15
STOP_LOSS_PERCENT=15

# How far out of the money, in whole strikes. NIFTY strikes are 50 apart, so
# Counted on the STRIKE_STEP grid below. Range 1-10.
TRADE_STRIKES_OUT=1

# Only strikes on this grid are chosen. 100 means round strikes only --
# 22,700 and 22,800, never 22,750 -- like the US "whole strike". With NIFTY
# at 22,716 and TRADE_STRIKES_OUT=1: CALL -> 22,800, PUT -> 22,700.
# Must be a multiple of the listed grid (NIFTY lists every 50).
STRIKE_STEP=100

# Of the round strikes out of the money, compare this many on TODAY'S VOLUME
# and trade the busiest -- a busy contract fills and exits at fair prices.
# With 3 and NIFTY at 22,716, a CALL compares 22,800 / 22,900 / 23,000.
# A tie goes to the nearer strike. 1 turns the comparison off.
STRIKE_CHOICES=3

# The most money ONE order may need, in rupees: premium x lots x lot size.
# An order over this is refused with TRADE_TOO_EXPENSIVE and nothing is sent.
MAX_TRADE_CASH=10000

# Scale the number of LOTS to the premium, so a cheap option buys more.
QUANTITY_TIERS_ENABLED=true

# "premium_under:lots", lowest first. The bound is EXCLUSIVE.
#
#     under  50  -> 3 lots   (at most 50 x 3 x 65 = 9,750)
#     50 - 75    -> 2 lots   (at most 75 x 2 x 65 = 9,750)
#     75 and up  -> QUANTITY_TIER_TOP
#
# SIZED FOR MAX_TRADE_CASH=10000 AND A 65 LOT. The server refuses to start
# if a band can need more than MAX_TRADE_CASH at LOT_SIZE -- change one and
# redraw the other.
QUANTITY_TIERS=50:3, 75:2
QUANTITY_TIER_TOP=1

# Used ONLY for that startup check. The real lot is read per contract.
LOT_SIZE=65

# One-click sell prices on the page, in RUPEES below the live premium.
QUICK_SELL_STEPS=0.25, 0.50, 1.00, 2.00, 5.00


# -----------------------------------------------------------------------------
# 4. WHICH SYMBOLS, AND THEIR BRACKETS
# -----------------------------------------------------------------------------
# Offered on the page's India view, in this order. Each can be switched off
# and given its own bracket from the page.
TRADE_SYMBOLS=NIFTY

# Optional per-symbol brackets, overriding the ones above:
# NIFTY_TAKE_PROFIT_PERCENT=20
# NIFTY_STOP_LOSS_PERCENT=15

# Pin every trade to one expiry, as YYYY-MM-DD. LEAVE BLANK to pick the
# soonest weekly expiry at least MIN_DAYS_TO_EXPIRY away.
TRADE_EXPIRY_DATE=

# Skip an expiry closer than this many days. 2 skips one expiring today or
# tomorrow, whose premium decays too fast to bracket sensibly.
MIN_DAYS_TO_EXPIRY=2


# -----------------------------------------------------------------------------
# 5. TIME-BASED BRACKETS
# -----------------------------------------------------------------------------
# From 09:30 IST: 20% / 20% until 10:15, then 5% / 10% for the rest of the
# session. Below a symbol's own bracket, above TAKE_PROFIT_PERCENT.
# The page can change these for India without a restart.
TIME_BRACKETS_ENABLED=true
TIME_BRACKETS_TIMEZONE=Asia/Kolkata
TIME_BRACKETS_START=09:30
TIME_BRACKETS_WINDOWS=45:20:20, *:5:10


# -----------------------------------------------------------------------------
# 6. HOW PRICES ARE DECIDED
# -----------------------------------------------------------------------------
# NIFTY options trade in five-paise steps.
OPTION_TICK_SIZE=0.05

# Whole ticks added to the BUY limit so it fills. 2 is ten paise.
LIMIT_BUFFER_TICKS=2

# -----------------------------------------------------------------------------
# 7. HOW THE EXITS RUN
# -----------------------------------------------------------------------------
# Angel has no "one cancels the other", and two exits resting together can
# BOTH fill and leave you short. So exactly one exit is ever on the book:
#
#   STOP LOSS    a stop-limit order at the exchange, placed as soon as the
#                buy fills. Protects the position even if this PC is off.
#   TAKE PROFIT  watched by this service. When the price gets there, the stop
#                is cancelled first, then the position is sold.
#
# An exit SELL is placed this many ticks below its price so a fast market
# still fills it. 20 ticks is Rs 1.00; never more than 10% of the price.
EXIT_SLIPPAGE_TICKS=20

# An exit still unfilled after this many seconds -- a stop that fired into a
# gap -- is cancelled and the rest is sold at MARKET.
STUCK_EXIT_SECONDS=10

# How often the take profit and the exits are checked, in seconds.
EXIT_POLL_SECONDS=1
