# =============================================================================
#  THE HTTP SERVER  --  config/server.env
# =============================================================================
#  Shared by every market: the API key, and where the server listens.
#  Gitignored. Restart the server after changing anything here.
# =============================================================================

# -----------------------------------------------------------------------------
# THE HTTP SERVER
# -----------------------------------------------------------------------------
# Lock 0. Every request must send this as the X-API-Key header or it is
# refused with 401 before it reaches a route. The server will not start
# without one -- an HTTP port that can place orders is a different risk from
# a CLI. Generate a long random value.
TIGER_API_KEY=

# 127.0.0.1 means only this machine can reach it. Do not set 0.0.0.0 unless
# you have genuinely decided to expose an order-placing service to your
# network.
API_HOST=127.0.0.1
API_PORT=8000

# How long a client_order_id is remembered, so a retry replays the first
# outcome instead of placing a second order.
IDEMPOTENCY_TTL_SECONDS=600
